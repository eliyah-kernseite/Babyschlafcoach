# Fuer das Hosting bei Hostinger (Apache/LiteSpeed) unter https://babyschlaf-coach.de/.

Options -Indexes
ErrorDocument 404 /404.html

# Interne Verzeichnisse nicht ausliefern. contact.php liest sie weiterhin ueber das Dateisystem.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/private/
  RedirectMatch 404 ^/vendor/
  # Quellcode, Tests und Arbeitsdateien gehoeren nicht auf die Website.
  RedirectMatch 404 ^/(src|tests|scripts|docs|node_modules|test-results)(/|$)
  RedirectMatch 404 ^/(package\.json|package-lock\.json|README\.md|[^/]+\.zip)$
</IfModule>

# www auf die Hauptadresse ohne www umleiten (Schema bleibt erhalten).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.babyschlaf-coach\.de$ [NC]
  RewriteCond %{HTTPS} on
  RewriteRule ^ https://babyschlaf-coach.de%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.babyschlaf-coach\.de$ [NC]
  RewriteRule ^ http://babyschlaf-coach.de%{REQUEST_URI} [R=301,L]
</IfModule>

# CSS und JS tragen eine Versionsnummer in der Adresse und duerfen lange zwischengespeichert werden.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Punktdateien (.htaccess, .nojekyll, .git*) nicht ausliefern.
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>
